<?xml version="1.0" encoding="UTF-8"?>
<!--
  Console logging for the demo. The serverId comes from the SLF4J MDC so every line is
  attributable to a host, and event=... key=value pairs make the state changes readable
  to someone who is not reading the code.
-->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [server=%X{serverId:-?}] %logger{0} | %msg%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
